# Copy to .env and fill in real values. Never commit .env.

# --- Database ---
DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- Auth (better-auth) ---
# Generate a strong random string, e.g. `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# Absolute origin better-auth issues callbacks against
BETTER_AUTH_URL=http://localhost:3000

# --- Absolute app origin ---
# Required in production: server-side oRPC calls fall back to http://localhost:3000
# when this is unset, which breaks any deployed build.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Mux (video processing) ---
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

# --- UploadThing (file uploads) ---
UPLOADTHING_TOKEN=

# --- Paystack (payments) ---
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# --- Inngest (background jobs) ---
# 1 for local dev server, unset/0 in production
INNGEST_DEV=1
